{
  "installCommand": "echo skip",
  "buildCommand": "mkdir -p dist && cp -r src/mn_doc_poc/__dist__/* dist/",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "vercel_src/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ]
}
